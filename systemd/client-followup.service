[Unit]
Description=Client Follow-up local server
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/client-followup/app
ExecStart=%h/.local/share/client-followup/app/client-followup -addr 127.0.0.1:8080 -db %h/.local/share/client-followup/data/client-followup.db -backups %h/.local/share/client-followup/backups
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
